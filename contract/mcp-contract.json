        "$schema": "http://json-schema.org/draft-07/schema#",
        "properties": {
          "points": {
            "description": "1 to 12 points, usually 4 to 10",
            "items": {
              "properties": {
                "direction": {
                  "description": "How to treat it: the angle, an example to use, what to avoid. Not finished sentences",
                  "type": "string"
                },
                "evidence": {
                  "description": "The fact or figure to use and where it comes from; empty when no research supports the point",
                  "type": "string"
                },
                "point": {
                  "description": "The idea or claim, one short sentence",
                  "type": "string"
                },
                "refs": {
                  "description": "Numbers of the section's research items it uses",
                  "items": {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "type": "array"
                },
                "sub_section": {
                  "description": "The planned sub-section it belongs to, if any",
                  "type": "string"
                }
              },
              "required": [
                "point"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "section_id": {
            "description": "The section id from writ_get_piece",
            "type": "string"
          }
        },
        "required": [
          "section_id",
          "points"
        ],
        "type": "object"
      }
