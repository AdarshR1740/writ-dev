# Copy to /etc/caddy/Caddyfile on the VM. Caddy gets and renews the HTTPS certificate by itself.
writ-v1.duckdns.org {
	encode zstd gzip

	# The app's settings live on the server, not in the repo or the build.
	handle /config.js {
		root * /etc/writ
		header Cache-Control "no-store"
		file_server
	}

	# Reserved for the remote MCP server (not built yet); until then this answers 502.
	handle /mcp* {
		reverse_proxy 127.0.0.1:3100
	}

	handle {
		root * /srv/writ/current/web/dist
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
