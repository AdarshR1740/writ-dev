# Writ's site block. Not a standalone Caddyfile: jobdeck's Caddy imports it (see docs/hosting.md).
# Caddy gets and renews the HTTPS certificate for this name by itself.
writ-v1.duckdns.org {
	encode zstd gzip

	# The app's settings live on the server, not in the repo or the build.
	handle /config.js {
		root * /etc/writ
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * /srv/writ/current/web/dist
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
