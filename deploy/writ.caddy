# Writ's site block. Not a standalone Caddyfile: jobdeck's Caddy imports it (see docs/hosting.md).
# Caddy gets and renews the HTTPS certificate for this name by itself.
writ-v1.duckdns.org {
	encode zstd gzip

	# The app's settings live on the server, not in the repo or the build.
	handle /config.js {
		root * /etc/writ
		header Cache-Control "no-store"
		file_server
	}

	# The hosted MCP server, a service on the VM itself (Caddy runs in Docker, hence host.docker.internal).
	handle /mcp {
		reverse_proxy host.docker.internal:3100
	}
	handle /mcp/* {
		reverse_proxy host.docker.internal:3100
	}
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy host.docker.internal:3100
	}

	# This site is not the sign-in server (Supabase is): answer 404, not the web app's page, so clients don't read HTML as metadata.
	handle /.well-known/oauth-authorization-server* {
		respond 404
	}
	handle /.well-known/openid-configuration* {
		respond 404
	}

	handle {
		root * /srv/writ/current/web/dist
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
